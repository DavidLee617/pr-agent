<?xml version="1.0" encoding="UTF-8"?>
<!--
  C# 对照：pom.xml ≈ .csproj
  - <parent> 继承 Spring Boot 的版本管理，类似 Directory.Packages.props（中央包版本管理）
  - <dependencies> ≈ <PackageReference>，Maven Central ≈ NuGet
  - mvn package ≈ dotnet publish；产物是一个可执行 jar（≈ 自包含的 publish 目录）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 2026-10-02 查 Maven Central：3.5.x 最新 GA 为 3.5.16（与 pr-reviewer 一致） -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.lee</groupId>
    <artifactId>pr-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>pr-agent</name>
    <description>DeepSeek-driven PR review agent, MCP client of pr-reviewer</description>

    <properties>
        <!-- C# 对照：≈ <TargetFramework>net8.0</TargetFramework> -->
        <java.version>21</java.version>
        <!-- 2026-10-02 查 Maven Central：1.x 最新 GA 为 1.1.8（2.x 需要 Spring Boot 4） -->
        <spring-ai.version>1.1.8</spring-ai.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 外层 Agent 的 LLM：DeepSeek 走 OpenAI 兼容接口（≈ Microsoft.Extensions.AI 的 IChatClient） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- MCP 客户端（stdio 传输）：把 pr-reviewer.jar mcp 当子进程拉起并调用它的 tools -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!-- 配置校验（@NotBlank 等）。C# 对照：≈ DataAnnotations + ValidateOnStart() -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JUnit 5 + AssertJ + Mockito。C# 对照：≈ xUnit + FluentAssertions + Moq -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- BOM：统一锁定 Spring AI 各模块版本，子依赖不用写 version -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <finalName>pr-agent</finalName>
        <plugins>
            <!-- 打成可执行 fat jar：java -jar target/pr-agent.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
